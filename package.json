{
  "name": "deal-terminal",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "start": "node apps/server/dist/main.js",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter @deal/portal run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @deal/db run generate",
    "db:migrate": "pnpm --filter @deal/db run migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
