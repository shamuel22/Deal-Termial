# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# URL pública del servidor (retornos de PayPal y webhooks)
PUBLIC_BASE_URL=https://tu-dominio.example

# PostgreSQL ≥ 16. Codifica caracteres especiales de la contraseña (@ → %40)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/deal_terminal
# Solo para tests
TEST_DATABASE_URL=postgres://usuario:contraseña@localhost:5432/deal_terminal_test

# PayPal (solo sandbox en el MVP)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# BN code de la app (Developer Dashboard → app → Multiparty features)
PAYPAL_BN_CODE=
